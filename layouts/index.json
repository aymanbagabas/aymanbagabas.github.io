[
{{- $first := true -}}
{{- range (where .Site.RegularPages "Section" "posts").ByDate.Reverse -}}
{{- if not $first }},{{ end }}{{ $first = false }}
  {
    "title": {{ .Title | jsonify }},
    "url":   {{ .RelPermalink | jsonify }},
    "date":  {{ (.Date.Format "Jan 2006") | jsonify }},
    "dateISO": {{ (.Date.Format "2006-01-02") | jsonify }},
    "tags":  {{ .Params.tags | jsonify }},
    "content": {{ .Plain | jsonify }}
  }
{{- end -}}
]
